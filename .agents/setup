#!/usr/bin/env bash
set -euo pipefail
if [[ "$(node -p 'process.versions.node.split(".")[0]')" -lt 26 ]]; then
  echo "Node >=26 is required. Select the Node 26 orb toolchain."
  exit 1
fi
echo "Installing pinned pnpm workspace dependencies, Playwright Chromium, and building both apps"
if ! command -v pnpm >/dev/null; then npm install -g "pnpm@$(node -p "require('./package.json').devEngines.packageManager.version")"; fi
pnpm install --frozen-lockfile
pnpm --dir apps/web exec playwright install --with-deps chromium
pnpm build

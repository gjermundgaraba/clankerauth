{
  "name": "@gjermundgaraba/clankerauth-dev",
  "version": "0.3.0",
  "description": "Disposable local Clankerauth issuer for application development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clankerauth.git",
    "directory": "packages/dev"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vp pack && node scripts/assets.mjs",
    "test": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@clankerauth/api": "workspace:*",
    "@clankerauth/server": "workspace:*",
    "@clankerauth/web": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}

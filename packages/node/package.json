{
  "name": "@gjermundgaraba/clankerauth-node",
  "version": "0.2.1",
  "description": "Clankerauth integration for Node services: token and API-key verification, protected-resource metadata, and browser login with server-held tokens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clankerauth.git",
    "directory": "packages/node"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {

{
  "name": "@gjermundgaraba/clankerauth-sdk",
  "version": "0.24.1",
  "description": "Effect-native clankerauth access-token and offline API-key verification, with optional effect-actions integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clankerauth.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./effect-actions": {
      "types": "./dist/effect-actions.d.ts",
      "import": "./dist/effect-actions.js"
    },
    "./key-list": {
      "types": "./dist/key-list.d.ts",
      "import": "./dist/key-list.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test && node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "jose": "catalog:",
    "oauth4webapi": "catalog:",
    "proper-lockfile": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@gjermundgaraba/effect-actions": "catalog:",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@gjermundgaraba/effect-actions": "^0.18.0",
    "effect": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@gjermundgaraba/effect-actions": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}

{
  "name": "clankerauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "build": "vp run -r build",
    "check": "vp check",
    "test": "vp run -r test",
    "ready": "vp check && vp run -r build && vp run -r test",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.mjs",
    "test:interop": "node apps/server/scripts/mcp-interop.mjs",
    "test:package": "node apps/server/scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4"
}

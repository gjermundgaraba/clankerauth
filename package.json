{
  "name": "clankerauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @gjermundgaraba/clankerauth-admin-api#build && vp run --no-cache --parallel -r dev",
    "build": "vp run -r build",
    "check": "vp run @gjermundgaraba/clankerauth-sdk#build && vp run @gjermundgaraba/clankerauth-admin-api#build && vp check && vp run test:lint",
    "test": "vp run -r test",
    "ready": "vp run check && vp run -r build && vp run -r test && vp run @clankerauth/web#test:smoke",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.mjs",
    "test:package": "node apps/server/scripts/production-smoke.mjs",
    "test:lint": "vp test run",
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@clanker-stuff/oxlint-config": "catalog:",
    "@effect/tsgo": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}

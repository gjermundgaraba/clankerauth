# Stable externally visible HTTPS origin; loopback HTTP is only for development.
AUTH_BASE_URL=http://localhost:3000
# Replace with at least 32 cryptographically random bytes, e.g. openssl rand -hex 32.
BETTER_AUTH_SECRET=
AUTH_DATABASE=data/auth.sqlite
HOST=127.0.0.1
PORT=3000
# Exact resource identifiers are audiences; a client registration selects ONE resource.
AUTH_RESOURCES=[{"identifier":"https://okf.internal/mcp","name":"OKF MCP","scopes":["okf:read","okf:write"]},{"identifier":"https://okf.internal/api","name":"OKF JSON API","scopes":["okf:read","okf:write"]}]

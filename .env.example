# Stable externally visible HTTPS origin; loopback HTTP is only for development.
# Set ALLOW_INSECURE_HTTP=true to run plain HTTP on a private network.
AUTH_BASE_URL=http://localhost:3000
# Replace with at least 32 cryptographically random bytes, e.g. openssl rand -hex 32.
BETTER_AUTH_SECRET=
AUTH_DATABASE=data/auth.sqlite
HOST=127.0.0.1
PORT=3000
# Behind a reverse proxy that sets X-Forwarded-For, attribute rate limits to its last hop.
# TRUST_PROXY=true
# Parent domain the forward-auth cookie is shared with, so apps under it can use forward auth.
# AUTH_COOKIE_DOMAIN=home.example

# Additional browser origins for OAuth-authenticated administration MCP.
# MCP_ALLOWED_ORIGINS=https://mcp.example.com,http://localhost:5173

# OpenTelemetry collector; standard OTEL_* variables apply. Without it nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal:4318
